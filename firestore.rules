rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId);
    }

    // 2. Active presences for real-time online counter
    match /active_presences/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 3. Conversations collection & messages
    match /conversations/{conversationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.id is string
          && request.resource.data.conversationId is string
          && request.resource.data.senderId is string;
        allow update: if true;
        allow delete: if isSignedIn() || resource.data.senderId.matches('^demo_user_.*');
      }
    }

    // 4. Stories collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isSignedIn() || resource.data.userId.matches('^demo_user_.*');
    }
  }
}
